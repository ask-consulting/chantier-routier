{
  "name": "chantia",
  "private": true,
  "version": "0.1.0",
  "description": "Gestion de chantiers routiers — monorepo (web + mobile + shared)",
  "packageManager": "pnpm@10.28.2",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "prepare": "husky || true",
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "api": "pnpm --filter @chantia/api dev",
    "web": "pnpm --filter @chantia/web dev",
    "mobile": "pnpm --filter @chantia/mobile start",
    "clean": "turbo run clean && rm -rf node_modules"
  },
  "devDependencies": {
    "husky": "^9.1.7",
    "lint-staged": "^16.4.0",
    "turbo": "^2.11.10",
    "typescript": "^5.9.3"
  },
  "pnpm": {
    "overrides": {
      "fast-uri@^3": "^3.1.5",
      "fast-uri@^4": "^4.1.2",
      "find-my-way": "^9.7.0",
      "js-yaml@^4": "^4.3.1",
      "js-yaml@^5": "^5.2.2",
      "postcss": "^8.5.23",
      "sharp": "^0.35.0",
      "brace-expansion@^1": "^1.1.18",
      "brace-expansion@^5": "^5.0.9",
      "nanoid@^3": "^3.3.18",
      "deepmerge-ts": "^8.0.0",
      "fastify": "^5.12.8"
    }
  }
}
