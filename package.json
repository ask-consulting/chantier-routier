{
  "name": "chantia",
  "private": true,
  "version": "0.1.0",
  "description": "Gestion de chantiers routiers — monorepo (web + mobile + shared)",
  "packageManager": "pnpm@10.28.2",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "api": "pnpm --filter @chantia/api dev",
    "web": "pnpm --filter @chantia/web dev",
    "mobile": "pnpm --filter @chantia/mobile start",
    "clean": "turbo run clean && rm -rf node_modules"
  },
  "devDependencies": {
    "turbo": "^2.3.3",
    "typescript": "^5.7.2"
  }
}
