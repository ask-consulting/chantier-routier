# API that receives access requests.
NEXT_PUBLIC_API_URL=https://chantia-api.onrender.com
# The application itself ("Se connecter").
NEXT_PUBLIC_APP_URL=https://app.chantia.tn
# Contact, shown only when set. WhatsApp in international format, digits only.
NEXT_PUBLIC_WHATSAPP=
NEXT_PUBLIC_CONTACT_EMAIL=contact@chantia.tn
# Store links: until set, the buttons say "soon" and link nowhere.
NEXT_PUBLIC_APP_STORE_URL=
NEXT_PUBLIC_GOOGLE_PLAY_URL=
