// Prisma schema — road worksite management API.
// Datasource: PostgreSQL (Supabase-managed in the free-tier deployment).
//
// Naming follows docs/10-conventions-base-de-donnees.md:
//   - tables      snake_case plural          `worksites`, `app_users`
//   - columns     snake_case                 `organization_id`, `planned_start_date`
//   - constraints pk_ / fk_ / uq_ / ix_      `pk_worksites`, `ix_worksites_organization_id`
//   - Prisma side stays PascalCase / camelCase; `@@map` and `@map` bridge the two.
//
// Three Postgres schemas, on purpose — one per bounded context:
//   - "identity"     — the Identity context (organizations, accounts, sessions).
//     Self-contained and extractable into its own service: `pg_dump -n identity`.
//   - "notification" — what gets sent, in which language, on which channel.
//     Same deal: `pg_dump -n notification` carries the whole module.
//   - "public"       — the business domain (worksites, workers, timesheets, expenses).
//
// NO foreign key crosses those boundaries. Business rows reference `organization_id`
// (and `app_users.worker_id` references a worker) as opaque UUIDs, exactly as they
// would across a network call. Referential integrity across contexts is the
// application's job, not the database's. See docs/08-identity-module.md.

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["multiSchema"]
}

datasource db {
  provider  = "postgresql"
  // Runtime connection — use the pooled URL in production (e.g. Supabase pooler).
  url       = env("DATABASE_URL")
  // Direct (non-pooled) connection used for migrations. Locally / on a single
  // database, set it to the same value as DATABASE_URL.
  directUrl = env("DIRECT_URL")
  schemas   = ["identity", "notification", "public"]
}

// ---------------------------------------------------------------------------
// Identity context — owns tenants, accounts and refresh sessions.
// ---------------------------------------------------------------------------

/// Interface language of an account. Mirrors `Locale` in @chantia/shared.
enum UserLocale {
  fr
  ar

  @@map("user_locale")
  @@schema("identity")
}

enum UserRole {
  admin
  site_manager
  foreman
  worker

  @@map("user_role")
  @@schema("identity")
}

/// Tenant registry. Source of truth for organizations; business rows only carry
/// the id. Lives in the identity context because sign-up creates it.
model Organization {
  id        String   @id(map: "pk_organizations") @default(uuid()) @db.Uuid
  name      String
  currency  String   @default("EUR")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  users User[]

  @@map("organizations")
  @@schema("identity")
}

/// A login account. Distinct from `Worker`: a worker is an HR record that may
/// have no account at all (no smartphone on site), and an account may belong to
/// office staff with no worker record.
model User {
  id             String     @id(map: "pk_app_users") @default(uuid()) @db.Uuid
  organizationId String     @map("organization_id") @db.Uuid
  /// Login identifier, stored lower-cased. Globally unique: a user belongs to
  /// exactly one organization, so login needs no tenant selector.
  email          String     @unique(map: "uq_app_users_email")
  /// Encoded as `scrypt$N$r$p$salt$key` — never leaves the identity context.
  /// NULL between the invitation and its acceptance: an invited account exists,
  /// carries a role, and cannot yet authenticate.
  passwordHash   String?    @map("password_hash")
  firstName      String     @map("first_name")
  lastName       String     @map("last_name")
  role           UserRole   @default(worker)
  active         Boolean    @default(true)
  /// Soft reference to `public.workers.id` — deliberately NOT a foreign key, so
  /// the identity context stays extractable. Nulled by the application when the
  /// worker is deleted.
  workerId       String?    @unique(map: "uq_app_users_worker_id") @map("worker_id") @db.Uuid
  /// Interface language. A preference of the person, not of their browser, so it
  /// follows them from the office desktop to the phone on site.
  locale         UserLocale @default(fr)
  lastLoginAt    DateTime?  @map("last_login_at")
  createdAt      DateTime   @default(now()) @map("created_at")
  updatedAt      DateTime   @updatedAt @map("updated_at")

  organization    Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade, map: "fk_app_users_organizations")
  refreshTokens   RefreshToken[]
  invitations     Invitation[]   @relation("InvitationInvitee")
  /// Invitations this account sent. Nulled — not cascaded — when it is deleted:
  /// an invitation outlives the admin who left.
  invitationsSent Invitation[]   @relation("InvitationInviter")

  @@index([organizationId], map: "ix_app_users_organization_id")
  @@map("app_users")
  @@schema("identity")
}

/// One row per issued refresh token. Tokens are opaque and stored hashed, so a
/// database leak cannot be replayed. Rotated on every refresh; presenting an
/// already-rotated token revokes the whole family (reuse detection).
model RefreshToken {
  id         String    @id(map: "pk_refresh_tokens") @default(uuid()) @db.Uuid
  userId     String    @map("user_id") @db.Uuid
  /// SHA-256 of the opaque token. The token itself is never persisted.
  tokenHash  String    @unique(map: "uq_refresh_tokens_token_hash") @map("token_hash")
  expiresAt  DateTime  @map("expires_at")
  revokedAt  DateTime? @map("revoked_at")
  /// Id of the token this one was rotated into — the audit trail of a family.
  replacedBy String?   @map("replaced_by") @db.Uuid
  userAgent  String?   @map("user_agent")
  createdAt  DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade, map: "fk_refresh_tokens_app_users")

  @@index([userId], map: "ix_refresh_tokens_user_id")
  @@index([expiresAt], map: "ix_refresh_tokens_expires_at")
  @@map("refresh_tokens")
  @@schema("identity")
}

/// An invitation to join the organization.
///
/// Same shape as a refresh token, for the same reason: the clear-text token is
/// handed over once and only its SHA-256 is kept, so a database leak yields
/// nothing usable. Single-use and time-limited.
///
/// Delivery goes through the notification module: the API issues the token and
/// hands the render to `SendNotificationCommand` (docs/14 §5.2).
model Invitation {
  id          String    @id(map: "pk_invitations") @default(uuid()) @db.Uuid
  userId      String    @map("user_id") @db.Uuid
  /// SHA-256 of the opaque token. The token itself is never persisted.
  tokenHash   String    @unique(map: "uq_invitations_token_hash") @map("token_hash")
  expiresAt   DateTime  @map("expires_at")
  acceptedAt  DateTime? @map("accepted_at")
  /// Who invited them.
  ///
  /// A real relation since 2 September 2026. It was a bare id at first — a
  /// second relation to `User` needs naming on both sides, for an audit field
  /// nothing joined on. The invitations screen made it something we *do* join
  /// on, several times a page, so the reason expired.
  ///
  /// Nullable, and `SetNull` rather than `Cascade`: an invitation outlives the
  /// admin who sent it and then left, and deleting a manager must never take
  /// somebody else's pending invitation with it.
  invitedById String?   @map("invited_by_id") @db.Uuid
  createdAt   DateTime  @default(now()) @map("created_at")

  user      User  @relation("InvitationInvitee", fields: [userId], references: [id], onDelete: Cascade, map: "fk_invitations_app_users")
  invitedBy User? @relation("InvitationInviter", fields: [invitedById], references: [id], onDelete: SetNull, map: "fk_invitations_invited_by")

  @@index([userId], map: "ix_invitations_user_id")
  @@index([invitedById], map: "ix_invitations_invited_by_id")
  @@index([expiresAt], map: "ix_invitations_expires_at")
  @@map("invitations")
  @@schema("identity")
}

// ---------------------------------------------------------------------------
// Business context — worksites and field data.
// ---------------------------------------------------------------------------

enum WorksiteStatus {
  upcoming
  in_progress
  completed
  suspended

  @@map("worksite_status")
  @@schema("public")
}

enum ExpenseType {
  labor
  materials
  equipment
  subcontracting
  other

  @@map("expense_type")
  @@schema("public")
}

model Worksite {
  id               String         @id(map: "pk_worksites") @default(uuid()) @db.Uuid
  /// Soft reference to `identity.organizations.id` — no foreign key by design.
  organizationId   String         @map("organization_id") @db.Uuid
  code             String
  name             String
  /// The client this worksite is built for. `NoAction` rather than cascade:
  /// clients are soft-deleted, so a real `DELETE` on one is never issued — and
  /// if it ever were, it must fail rather than take worksites with it.
  clientId         String?        @map("client_id") @db.Uuid
  address          String?
  latitude         Float?
  longitude        Float?
  plannedStartDate DateTime?      @map("planned_start_date")
  plannedEndDate   DateTime?      @map("planned_end_date")
  status           WorksiteStatus @default(upcoming)
  totalBudget      Decimal?       @map("total_budget") @db.Decimal(14, 2)
  /// Set instead of a real delete: `timesheets` and `expenses` cascade from
  /// this row, and an actual `DELETE` would erase hours somebody was paid for.
  /// `null` means current; every query that lists or looks up a worksite
  /// filters on it — the second table, after `workers`, to pay the discipline
  /// docs/10 warns a soft delete demands, for the same reason.
  deletedAt        DateTime?      @map("deleted_at")
  createdAt        DateTime       @default(now()) @map("created_at")
  updatedAt        DateTime       @updatedAt @map("updated_at")

  client     Client?     @relation(fields: [clientId], references: [id], onDelete: NoAction, map: "fk_worksites_clients")
  timesheets Timesheet[]
  expenses   Expense[]

  /// Partial in the database — `WHERE deleted_at IS NULL`, see migration
  /// `20260925120000_worksite_soft_delete` — so a deleted worksite frees its
  /// code. Prisma cannot express the predicate; it reads the index back as a
  /// plain unique one, which is why declaring it here causes no drift.
  @@unique([organizationId, code], map: "uq_worksites_organization_id_code")
  @@index([organizationId], map: "ix_worksites_organization_id")
  @@index([clientId], map: "ix_worksites_client_id")
  @@map("worksites")
  @@schema("public")
}

model Worker {
  id             String    @id(map: "pk_workers") @default(uuid()) @db.Uuid
  /// Soft reference to `identity.organizations.id` — no foreign key by design.
  organizationId String    @map("organization_id") @db.Uuid
  name           String
  qualification  String?
  hourlyRate     Decimal   @map("hourly_rate") @db.Decimal(10, 2)
  /// Still on the payroll — a reversible, voluntary state the admin sets by
  /// hand (on leave, seasonal). Distinct from `deletedAt`: that one is not
  /// reversible from the interface and is not something the admin "sets".
  active         Boolean   @default(true)
  /// Set instead of a real delete: `timesheets.worker_id` cascades, and an
  /// actual `DELETE` would erase the hours with it — silently rewriting the
  /// labour cost of every worksite this person appeared on. `null` means
  /// still current; every query that lists or looks up a worker filters on
  /// it, which is the discipline docs/10 §5 warns a generalised soft delete
  /// demands — paid here and on `worksites`, each for the reason above.
  deletedAt      DateTime? @map("deleted_at")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")

  timesheets Timesheet[]

  @@index([organizationId], map: "ix_workers_organization_id")
  @@map("workers")
  @@schema("public")
}

model Timesheet {
  id          String   @id(map: "pk_timesheets") @default(uuid()) @db.Uuid
  worksiteId  String   @map("worksite_id") @db.Uuid
  workerId    String   @map("worker_id") @db.Uuid
  date        DateTime @db.Date
  hoursWorked Decimal  @map("hours_worked") @db.Decimal(6, 2)
  present     Boolean  @default(true)
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  worksite Worksite @relation(fields: [worksiteId], references: [id], onDelete: Cascade, map: "fk_timesheets_worksites")
  worker   Worker   @relation(fields: [workerId], references: [id], onDelete: Cascade, map: "fk_timesheets_workers")

  @@unique([workerId, worksiteId, date], map: "uq_timesheets_worker_id_worksite_id_date")
  @@index([worksiteId], map: "ix_timesheets_worksite_id")
  @@map("timesheets")
  @@schema("public")
}

model Expense {
  id         String      @id(map: "pk_expenses") @default(uuid()) @db.Uuid
  worksiteId String      @map("worksite_id") @db.Uuid
  type       ExpenseType @default(other)
  label      String
  amount     Decimal     @db.Decimal(14, 2)
  date       DateTime    @db.Date
  supplier   String?
  createdAt  DateTime    @default(now()) @map("created_at")
  updatedAt  DateTime    @updatedAt @map("updated_at")

  worksite Worksite @relation(fields: [worksiteId], references: [id], onDelete: Cascade, map: "fk_expenses_worksites")

  @@index([worksiteId], map: "ix_expenses_worksite_id")
  @@map("expenses")
  @@schema("public")
}

// ---------------------------------------------------------------------------
// Notification context — what gets sent, in which language, on which channel.
//
// Its own schema rather than a corner of `identity` or of `public`: delivery is
// neither an identity concern nor business data, and the module is meant to
// become its own service — one `pg_dump -n notification` has to carry it whole.
// Nothing here references another schema — the recipient arrives as plain data.
// ---------------------------------------------------------------------------

/// What a notification is *about*. An enum rather than a free string because a
/// template is looked up by it: an unknown subject must be a compile error and a
/// migration, not a row silently missing at send time.
enum NotificationSubject {
  invitation

  @@map("notification_subject")
  @@schema("notification")
}

/// How it travels. `sms` exists in the schema and in the templates before it can
/// be sent: the table is the thing a migration fills, and back-filling a channel
/// later would mean re-editing every template.
enum NotificationChannel {
  email
  sms

  @@map("notification_channel")
  @@schema("notification")
}

/// Mirrors `Locale` in @chantia/shared, and deliberately NOT `identity.user_locale`.
/// No dependency crosses the schema boundary — enums included, or `pg_dump -n
/// identity` would stop being self-contained.
enum NotificationLocale {
  fr
  ar

  @@map("notification_locale")
  @@schema("notification")
}

/// One row per (subject, channel, locale).
///
/// No `organization_id`, on purpose: templates are product copy, not tenant data.
/// That also keeps them out of the multi-tenant extension, which filters only
/// models carrying the column — so a send works before any tenant is known.
///
/// Rows are created by migration only. A template is a contract between the code
/// that fills placeholders and the text that reads them; letting it be edited at
/// runtime would let the two drift with nothing to catch it.
model NotificationTemplate {
  id          String              @id(map: "pk_notification_templates") @default(uuid()) @db.Uuid
  subject     NotificationSubject
  channel     NotificationChannel
  locale      NotificationLocale
  /// Null on channels that carry no subject line — SMS.
  subjectLine String?             @map("subject_line")
  /// Placeholders are `{{name}}`. Every one must be supplied at send time.
  body        String
  createdAt   DateTime            @default(now()) @map("created_at")
  updatedAt   DateTime            @updatedAt @map("updated_at")

  @@unique([subject, channel, locale], map: "uq_notification_templates_subject_channel_locale")
  @@map("notification_templates")
  @@schema("notification")
}

enum ClientType {
  individual
  legal_entity

  @@map("client_type")
  @@schema("public")
}

/// Who a worksite is built for — a person, or a company / municipality /
/// ministry. The name columns depend on `type`; `displayName` is computed on
/// write (`clientDisplayName` in `@chantia/shared`) so lists can sort and
/// search one column whatever the type.
model Client {
  id                String     @id(map: "pk_clients") @default(uuid()) @db.Uuid
  /// Soft reference to `identity.organizations.id` — no foreign key by design.
  organizationId    String     @map("organization_id") @db.Uuid
  type              ClientType
  /// Individuals only.
  firstName         String?    @map("first_name")
  /// Individuals only.
  lastName          String?    @map("last_name")
  /// Legal entities only — the raison sociale.
  legalName         String?    @map("legal_name")
  displayName       String     @map("display_name")
  billingLine1      String?    @map("billing_line1")
  billingLine2      String?    @map("billing_line2")
  billingPostalCode String?    @map("billing_postal_code")
  billingCity       String?    @map("billing_city")
  /// ISO 3166-1 alpha-2.
  billingCountry    String     @default("TN") @map("billing_country") @db.Char(2)
  /// Set instead of a real delete, like `workers` and `worksites`: worksites
  /// point here, and a client removed by mistake must not take their history
  /// with it. `null` means current; every read filters on it.
  deletedAt         DateTime?  @map("deleted_at")
  createdAt         DateTime   @default(now()) @map("created_at")
  updatedAt         DateTime   @updatedAt @map("updated_at")

  contacts  ClientContact[]
  worksites Worksite[]

  @@index([organizationId], map: "ix_clients_organization_id")
  @@map("clients")
  @@schema("public")
}

/// A person to reach at a client. No `organizationId`: a contact only exists
/// through its client, which carries the tenant — the same arrangement as
/// `timesheets` under `worksites`. Written only through the client aggregate.
model ClientContact {
  id            String   @id(map: "pk_client_contacts") @default(uuid()) @db.Uuid
  clientId      String   @map("client_id") @db.Uuid
  firstName     String?  @map("first_name")
  lastName      String   @map("last_name")
  position      String?
  mobilePhone   String?  @map("mobile_phone")
  landlinePhone String?  @map("landline_phone")
  email         String?
  /// Exactly one per client once it has contacts — enforced by the aggregate.
  isPrimary     Boolean  @default(false) @map("is_primary")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  client Client @relation(fields: [clientId], references: [id], onDelete: Cascade, map: "fk_client_contacts_clients")

  @@index([clientId], map: "ix_client_contacts_client_id")
  @@map("client_contacts")
  @@schema("public")
}
