# API runtime
PORT=8080
NODE_ENV=development

# CORS — comma-separated additional allowed origins (web/mobile dev servers)
CORS_ORIGINS=http://localhost:3000

# PostgreSQL.
# - DATABASE_URL: runtime connection. In production use the pooled URL
#   (e.g. Supabase connection pooler).
# - DIRECT_URL: direct (non-pooled) connection used by Prisma migrations.
#   Locally / on a single database, set it to the same value as DATABASE_URL.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/chantia?schema=public"
DIRECT_URL="postgresql://postgres:postgres@localhost:5432/chantia?schema=public"

# Authentication.
# - JWT_ACCESS_SECRET: HS256 signing secret. REQUIRED — the API refuses to boot
#   without it, deliberately: a default would ship a publicly-known key.
#   Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# - The identity service signs with it, the business API verifies with it. Same
#   value on both once they are split apart.
JWT_ACCESS_SECRET=
JWT_ISSUER=chantia-identity
# Durée de vie de l'access token, en secondes (défaut 300 = 5 min). Short: it cannot be revoked.
JWT_ACCESS_TTL=300
# Refresh-token lifetime in seconds (default 2592000 = 30 days). Long: mobile stays
# logged in in the field.
JWT_REFRESH_TTL=2592000
# Minimum password length accepted at registration and password change.
MIN_PASSWORD_LENGTH=10

# Limitation de débit sur les routes d'authentification. Deux fenêtres :
# par adresse (un appelant qui essaie beaucoup de mots de passe) et par email
# (beaucoup d'adresses qui essaient un seul compte — une rotation d'IP ne
# contourne donc pas la première). Les valeurs par défaut conviennent ; les
# variables sont là pour resserrer sans redéployer.
THROTTLE_IP_LIMIT=20
THROTTLE_IP_TTL=60
THROTTLE_IDENTITY_LIMIT=10
THROTTLE_IDENTITY_TTL=900
# Durée du blocage une fois la limite franchie, en secondes. Plus longue que la
# fenêtre volontairement : sinon l'attaquant attend l'expiration du plus ancien
# essai et continue pile à la limite.
THROTTLE_BLOCK_DURATION=900
# Nombre de reverse proxies devant l'API, donc de maillons de X-Forwarded-For
# auxquels on se fie. 0 en local (aucun proxy) — et 0 est le défaut sûr : lire
# l'en-tête quand personne ne l'écrase laisse chaque appelant choisir son
# compteur. 1 sur Render. À l'inverse, laisser 0 derrière un proxy fait passer
# tout le trafic pour une seule adresse : les vingt premiers appels bloquent
# tout le monde.
TRUSTED_PROXY_HOPS=0

# Multi-tenant. Le filtre `organizationId` est injecté automatiquement dans les
# requêtes Prisma dès qu'un appelant est authentifié (voir docs/08-identity-module.md).
# `false` le désactive pour tout le processus — à réserver aux scripts de migration
# et à l'outillage support. Pour un seul appel, préférer TenantContext.runUnscoped().
MULTI_TENANT_ENABLED=true

# Inscription publique. Fermée par défaut : le produit ne sert qu'une organisation,
# et une route d'inscription ouverte sur un back-office privé est une invitation.
# `true` la rouvre (multi-tenant, plus tard).
ALLOW_SELF_REGISTRATION=false
# Durée de vie d'une invitation, en secondes (défaut 604800 = 7 jours).
INVITATION_TTL=604800

# Amorçage du premier administrateur — utilisé seulement par `bootstrap:admin`,
# jamais lu par le serveur. À ne pas laisser dans un .env de production.
#   BOOTSTRAP_ADMIN_EMAIL=vous@exemple.fr BOOTSTRAP_ADMIN_PASSWORD=… \
#     pnpm --filter @chantia/api bootstrap:admin
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=
BOOTSTRAP_ADMIN_FIRST_NAME=
BOOTSTRAP_ADMIN_LAST_NAME=
