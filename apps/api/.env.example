# API runtime
PORT=8080
NODE_ENV=development

# CORS — comma-separated additional allowed origins (web/mobile dev servers)
CORS_ORIGINS=http://localhost:3000

# PostgreSQL.
# - DATABASE_URL: runtime connection. In production use the pooled URL
#   (e.g. Supabase connection pooler).
# - DIRECT_URL: direct (non-pooled) connection used by Prisma migrations.
#   Locally / on a single database, set it to the same value as DATABASE_URL.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/chantia?schema=public"
DIRECT_URL="postgresql://postgres:postgres@localhost:5432/chantia?schema=public"

# Authentication.
# - JWT_ACCESS_SECRET: HS256 signing secret. REQUIRED — the API refuses to boot
#   without it, deliberately: a default would ship a publicly-known key.
#   Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# - The identity service signs with it, the business API verifies with it. Same
#   value on both once they are split apart.
JWT_ACCESS_SECRET=
JWT_ISSUER=chantia-identity
# Access-token lifetime in seconds (default 900 = 15 min). Short: it cannot be revoked.
JWT_ACCESS_TTL=900
# Refresh-token lifetime in seconds (default 2592000 = 30 days). Long: mobile stays
# logged in in the field.
JWT_REFRESH_TTL=2592000
# Minimum password length accepted at registration and password change.
MIN_PASSWORD_LENGTH=10

# Multi-tenant. Le filtre `organizationId` est injecté automatiquement dans les
# requêtes Prisma dès qu'un appelant est authentifié (voir docs/08-identity-module.md).
# `false` le désactive pour tout le processus — à réserver aux scripts de migration
# et à l'outillage support. Pour un seul appel, préférer TenantContext.runUnscoped().
MULTI_TENANT_ENABLED=true
