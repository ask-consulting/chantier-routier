# API runtime
PORT=8080
NODE_ENV=development

# CORS — comma-separated additional allowed origins (web/mobile dev servers)
CORS_ORIGINS=http://localhost:3000

# PostgreSQL.
# - DATABASE_URL: runtime connection. In production use the pooled URL
#   (e.g. Supabase connection pooler).
# - DIRECT_URL: direct (non-pooled) connection used by Prisma migrations.
#   Locally / on a single database, set it to the same value as DATABASE_URL.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/chantia?schema=public"
DIRECT_URL="postgresql://postgres:postgres@localhost:5432/chantia?schema=public"
