# API runtime
PORT=8080
NODE_ENV=development

# CORS — comma-separated additional allowed origins (web/mobile dev servers)
CORS_ORIGINS=http://localhost:3000

# PostgreSQL (Supabase: use the connection pooler URL for the app,
# and the direct URL for migrations).
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/chantier?schema=public"
